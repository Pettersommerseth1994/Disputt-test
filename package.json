{
  "name": "disputt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Disputt – et sosialt bløff- og diskusjonsspill for 3+ spillere. Mobile first.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pettersommerseth1994/Disputt.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test \"test/*.test.js\"",
    "shots": "node tools/qa/shots.mjs",
    "art": "node tools/art/build.mjs && node tools/art/soften.mjs",
    "logo": "node tools/logo/build.mjs",
    "fonts": "bash tools/fonts/build.sh",
    "vendor": "node tools/vendor.mjs",
    "play": "node tools/qa/play.mjs",
    "pages:build": "node tools/pages/build.mjs",
    "pages:preview": "node tools/pages/serve.mjs",
    "play:p2p": "node tools/qa/play.mjs --p2p",
    "play:subpath": "node tools/qa/play.mjs --p2p --subpath",
    "play:pay": "node tools/qa/play.mjs 4 3 --p2p --pay",
    "qa:demo": "node tools/qa/demoflow.mjs",
    "play:pay-demo": "node tools/qa/play.mjs 4 3 --p2p --pay-demo",
    "play:pay-slow": "node tools/qa/play.mjs 3 3 --p2p --pay-slow",
    "play:live": "node tools/qa/play.mjs --url=https://disputt.site",
    "qa:stuck": "node tools/qa/stuck.mjs",
    "qa:signalling": "node tools/qa/signalling.mjs",
    "qa:hostile": "node tools/qa/hostile.mjs",
    "qa:fit": "node tools/qa/fit.mjs",
    "qa:overlap": "node tools/qa/overlap.mjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "fontkit": "^2.0.4",
    "htm": "^3.1.1",
    "jsqr": "^1.4.0",
    "peer": "^1.0.2",
    "peerjs": "^1.5.5",
    "preact": "^11.0.0",
    "puppeteer-core": "^25.12.0",
    "qrcode-generator": "^2.0.4",
    "sharp": "^0.35.5"
  }
}
